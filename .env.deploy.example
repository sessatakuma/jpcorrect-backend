# Deployment environment example for compose.deploy.yml.
PORT=8080
DATABASE_URL=postgres://jpcorrect:jpcorrect_password@postgres:5432/jpcorrect?sslmode=disable
API_TOOLS_URL=http://host.docker.internal:8000
API_TOOLS_KEY=change-me-to-a-secure-key
# Inbound API key for the 7 api-tools endpoints (X-API-Key header). Empty = disabled.
CLIENT_API_KEY=change-me-to-a-secure-key
BACKEND_IMAGE=ghcr.io/sessatakuma/jpcorrect-backend:latest
CLOUDFLARE_TUNNEL_TOKEN=

GIN_MODE=release
JWKS_URL=https://your-auth-provider.example/.well-known/jwks.json

# API HTTPS 憑證設定
API_CERT_PATH=./certs/cert.pem
API_KEY_PATH=./certs/key.pem

# WebRTC config
WEBRTC_CONN_SEC=10
WEBRTC_CONN_MAX=15

# WebSocket CORS 設定 (用逗號分隔多個來源)
ALLOWED_ORIGINS=

# WebRTC Demo 網頁設定
WEBRTC_DEMO_PORT=3000
WEBRTC_DEMO_BASE_DIR=./cmd/webrtc-demo
WEBRTC_DEMO_CERT_PATH=./cmd/webrtc-demo/certs/cert.pem
WEBRTC_DEMO_KEY_PATH=./cmd/webrtc-demo/certs/key.pem