# Local development environment example.
PORT=8080
DATABASE_URL=postgres://jpcorrect:jpcorrect_password@127.0.0.1:5432/jpcorrect?sslmode=disable
API_TOOLS_URL=http://127.0.0.1:8000
API_TOOLS_KEY=change-me-to-a-secure-key
# Inbound X-API-Key required for the 7 api-tools endpoints (JWT not accepted). Empty value returns 401.
CLIENT_API_KEY=change-me-to-a-secure-key
# Yahoo API key required by API-tools furigana_marker (consumed by `make api-tools`)
YAHOO_API_KEY=your-yahoo-api-key-here

GIN_MODE=debug
JWKS_URL=https://your-auth-provider.example/.well-known/jwks.json

# API HTTPS 憑證設定
API_CERT_PATH=./certs/cert.pem
API_KEY_PATH=./certs/key.pem

# WebRTC config
WEBRTC_CONN_SEC=10
WEBRTC_CONN_MAX=15

# WebSocket CORS 設定 (用逗號分隔多個來源)
ALLOWED_ORIGINS=

# WebRTC Demo 網頁設定
WEBRTC_DEMO_PORT=3000
WEBRTC_DEMO_BASE_DIR=./cmd/webrtc-demo
WEBRTC_DEMO_CERT_PATH=./cmd/webrtc-demo/certs/cert.pem
WEBRTC_DEMO_KEY_PATH=./cmd/webrtc-demo/certs/key.pem
