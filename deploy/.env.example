# Compose interpolation source for deploy/compose.yml.
#
# Copy to `deploy/.env` (gitignored) and fill in before the first
# `make -C deploy up`. Compose auto-loads `.env` from the directory holding
# compose.yml, which is the only place these can live: `env/prod` and
# `env/dev` are service `env_file`s, and those are handed to the container
# at runtime — they are NOT read during interpolation.
#
# Both values are consumed at `initdb` time only. Changing one afterwards
# does not rotate the password of an already-initialised volume; see
# README.md → "Postgres passwords".

# Password for postgres-prod. Must match the (URL-encoded) password inside
# env/prod's DATABASE_URL.
POSTGRES_PROD_PASSWORD=change-me-to-a-unique-random-value

# Password for postgres-dev. Must match env/dev's DATABASE_URL. Separate from
# prod on purpose: dev runs with the app middlewares skipped, so its
# credentials must never be usable against the prod database.
POSTGRES_DEV_PASSWORD=change-me-to-a-different-unique-random-value
