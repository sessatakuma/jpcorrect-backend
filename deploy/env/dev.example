# Internal-dev deploy env file — used by backend-dev (deploy/compose.yml).
# Reached only via api-dev.sessatakuma.dev which is gated by Cloudflare Access
# (Zero Trust application policy on the dashboard). GIN_MODE=debug exposes the
# Swagger UI and skips the X-API-Key check of the api-tools routes; user routes
# require a real Supabase JWT exactly like prod, so JWKS_URL is mandatory here
# too.
PORT=8080
GIN_MODE=debug
# Password must match POSTGRES_DEV_PASSWORD in deploy/.env (URL-encoded here).
# Keep it different from the prod one.
DATABASE_URL=postgres://jpcorrect:<POSTGRES_DEV_PASSWORD>@postgres-dev:5432/jpcorrect?sslmode=disable
API_TOOLS_URL=http://jpcorrect-api-tools-dev:8000

# Unused while GIN_MODE=debug (the api-tools key check is skipped). Leave empty.
CLIENT_API_KEY=
# Inbound X-API-Key for /internal/* only. Always enforced, in debug too, and
# separate from CLIENT_API_KEY. Empty value rejects every /internal request.
INTERNAL_API_KEY=change-me-to-a-secure-key
# JWKS document of the dev Supabase project. The process fatals without it.
JWKS_URL=https://your-dev-auth-provider.example/.well-known/jwks.json

# TLS inside the container — disabled; Cloudflare tunnel terminates TLS at the edge.
API_CERT_PATH=
API_KEY_PATH=

# WebRTC config (same defaults as prod)
WEBRTC_CONN_SEC=10
WEBRTC_CONN_MAX=15

# Open CORS in debug mode for Swagger UI's "Try it out" from any internal browser.
ALLOWED_ORIGINS=*
