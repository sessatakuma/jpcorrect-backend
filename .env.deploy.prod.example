# Production deploy env file — used by backend-prod (compose.deploy.yml).
# Public-facing at api.sessatakuma.dev; app enforces JWT + X-API-Key.
PORT=8080
GIN_MODE=release
DATABASE_URL=postgres://jpcorrect:jpcorrect_password@postgres-prod:5432/jpcorrect?sslmode=disable
API_TOOLS_URL=http://jpcorrect-api-tools:8000

# Inbound X-API-Key required for the 7 api-tools endpoints (JWT not accepted on those routes).
# Empty value returns 401. In release mode this is enforced.
CLIENT_API_KEY=change-me-to-a-secure-key

JWKS_URL=https://your-prod-auth-provider.example/.well-known/jwks.json

# TLS inside the container — disabled; the Cloudflare tunnel terminates TLS at the edge.
API_CERT_PATH=
API_KEY_PATH=

# WebRTC config
WEBRTC_CONN_SEC=10
WEBRTC_CONN_MAX=15

# CORS allowed origins for WebSocket / API (comma-separated). Empty rejects all in release mode.
ALLOWED_ORIGINS=https://your-frontend.sessatakuma.dev
